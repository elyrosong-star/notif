{
  "name": "alertes-platform",
  "version": "1.0.0",
  "description": "Alertes Teasing / Pressing",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.thajy.alertes",
    "productName": "Alertes Platform",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "artifactName": "Alertes-Setup.exe"
    }
  }
}
